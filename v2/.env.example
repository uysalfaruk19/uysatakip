# UYSA Kokpit v2 — ortam değişkenleri (kopyala: .env)  — .env GİT'e girmez
# Üretim: MySQL/MariaDB (utf8mb4). Test: DB_DRIVER=sqlite

DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=uysa_db
DB_USER=root
DB_PASS=

# Bot/iç API tokeni (X-UYSA-Token). Güçlü, rastgele üret. Koda GÖMÜLMEZ.
API_TOKEN=change-me-strong-random-token

# Yüklemeler
UPLOAD_DIR=
UPLOAD_MAX_MB=25

# Reverse proxy (traefik/nginx) arkasında mı? 1 ise X-Forwarded-For/Proto güvenilir kabul edilir.
# VPS'te traefik arkası → 1. Doğrudan/lokal → 0.
TRUST_PROXY=0

# Oturum
SESSION_NAME=uysa_kokpit

# ── Paraşüt (opus-012, SALT-OKUMA muhasebe) ──────────────────────────────
# 🔒 YEREL ÇALIŞIR — bu değerler VPS/sunucu .env'ine KONMAZ. Sadece Ömer'in PC'sinde
#    (secrets/parasut.txt veya buradaki env) durur; tools/parasut_sync.php okur, Paraşüt'ten
#    cari bakiyeleri ÇEKER (GET), Kokpit'e sadece sonuç rakamlarını /api/parasut_cari ile POST eder.
#    Sunucu Paraşüt'e HİÇ çağrı yapmaz. Boş bırak (VPS) → configured()=false.
PARASUT_CLIENT_ID=
PARASUT_CLIENT_SECRET=
PARASUT_USERNAME=
PARASUT_PASSWORD=
PARASUT_COMPANY_ID=
# Yerel senkron hedefi (tools/parasut_sync.php Kokpit'e POST eder):
KOKPIT_URL=
# API_TOKEN yukarıdaki değerle aynı (X-UYSA-Token). secrets/parasut.txt'te kokpit_url=/api_token= de verilebilir.
