# UYSA Kokpit v2 — ortam değişkenleri (kopyala: .env)  — .env GİT'e girmez
# Üretim: MySQL/MariaDB (utf8mb4). Test: DB_DRIVER=sqlite

DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=uysa_db
DB_USER=root
DB_PASS=

# Bot/iç API tokeni (X-UYSA-Token). Güçlü, rastgele üret. Koda GÖMÜLMEZ.
API_TOKEN=change-me-strong-random-token

# Yüklemeler
UPLOAD_DIR=
UPLOAD_MAX_MB=25

# Oturum
SESSION_NAME=uysa_kokpit
