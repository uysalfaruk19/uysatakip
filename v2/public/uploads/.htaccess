# Yüklenen dosyalar ASLA çalıştırılmaz — sadece indirilir (v1 güvenlik deseni)
php_flag engine off
AddType application/octet-stream .php .phtml .php3 .php4 .php5 .php7 .phar .cgi .pl .py .sh
<IfModule mod_rewrite.c>
  RewriteEngine On
</IfModule>
Options -ExecCGI -Indexes
<FilesMatch "\.(php|phtml|phar|cgi|pl|py|sh)$">
  Require all denied
</FilesMatch>
