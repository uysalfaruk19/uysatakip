# UYSA Kokpit v2 — üretim imajı.
# Build context = repo kökü:  docker build -f Dockerfile.v2 -t uysatakip-v2 .
# v2 uygulaması kökte (public/ web kökü), v1 SPA /eski arşivinde (salt-okunur, router korur).
FROM php:8.2-cli

# pdo_mysql (üretim DB) + zip (opus-016 Menü Excel import/export; SimpleXML/libxml zaten gömülü).
RUN apt-get update \
 && apt-get install -y --no-install-recommends libzip-dev \
 && rm -rf /var/lib/apt/lists/* \
 && docker-php-ext-install pdo pdo_mysql zip

# fable-080 (14 Ağu vakası): oturumlar konteyner içindeki /tmp'deydi → her `up --build`
# TÜM oturumları siliyordu. Ömer irsaliye keserken deploy'a denk geldi, "oturum doğrulaması
# başarısız" alıp iş yarıda kaldı; aynı tuzak garsonları da atıyordu. Oturum dizini KALICI
# volume'a taşındı (compose: uysatakip_sessions) → güncelleme artık kimseyi düşürmez.
RUN printf "upload_max_filesize=30M\npost_max_size=32M\nmemory_limit=256M\nmax_execution_time=120\nexpose_php=Off\nsession.save_path=/var/lib/php-sessions\nsession.gc_maxlifetime=28800\n" \
    > /usr/local/etc/php/conf.d/uysa.ini \
 && mkdir -p /var/lib/php-sessions && chmod 1733 /var/lib/php-sessions

WORKDIR /var/www/html

# v2 uygulama
COPY v2/src ./src
COPY v2/sql ./sql
COPY v2/tools ./tools
COPY v2/router.php ./router.php
COPY v2/public ./public

# v1 arşiv → /var/www/html/eski (router __DIR__/eski okur; docroot dışı, yalnız /eski/ handler'ından erişilir)
COPY public/ ./eski/

RUN mkdir -p public/uploads && chmod 777 public/uploads

EXPOSE 8080

# v1 ile aynı php -S deseni + router (pretty /api + /eski)
CMD ["sh", "-c", "php -S 0.0.0.0:${PORT:-8080} -t /var/www/html/public /var/www/html/router.php"]
