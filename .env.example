# UYSA ERP v5.0 — Ortam Değişkenleri
# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun
# Railway'de bu değerler "Variables" panelinden girilir

# ── Veritabanı (Railway MySQL) ────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=uysa_db
DB_USER=root
DB_PASS=

# ── API Güvenlik Tokeni ───────────────────────────────────────
# openssl rand -hex 32 ile güçlü token oluşturun
# index.html içindeki CFG.token ile EŞLEŞMELİDİR
API_TOKEN=change_me_to_a_strong_random_token

# ── JWT Gizli Anahtarı ───────────────────────────────────────
# En az 32 karakter olmalı
JWT_SECRET=change-jwt-secret-minimum-32-chars-here!!

# ── Yedek Yönetimi ────────────────────────────────────────────
BACKUP_MAX=30

# ── Dosya Yükleme ─────────────────────────────────────────────
UPLOAD_DIR=/app/public/uploads
UPLOAD_MAX_MB=25

# ── CORS (virgülle ayrılmış origin'ler) ──────────────────────
CORS_ORIGINS=https://uysatakip.production.up.railway.app,http://localhost,http://127.0.0.1

# ── AI Asistan (Claude API) ──────────────────────────────────
# ERP içi AI asistan ve Telegram bot için gerekli
ANTHROPIC_API_KEY=

# ── Telegram Bot ──────────────────────────────────────────────
# @BotFather'dan aldığınız bot token'ı
TELEGRAM_BOT_TOKEN=
